# Public site URL — no trailing slash
# Local:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vercel (set in Project → Settings → Environment Variables):
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Supabase (public) — REQUIRED on Vercel for Production + Preview
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser (Vercel: Production + Preview)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# After setting vars on Vercel: Redeploy. Then open /api/health — supabase.public should be true.
