# Public site URL — no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SMTP (Gmail app password — server only, never expose to browser)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
# Alias also accepted by the mail helper:
# SMTP_PASSWORD=your-app-password
SMTP_FROM="Your App <no-reply@yourdomain.com>"

# Comma-separated staff inboxes for new ask/contact alerts
ADMIN_NOTIFY_EMAILS=admin@example.com,editor@example.com
